---
// src/components/ChatWidget.astro
import { Image } from 'astro:assets';
import logoIcon from '../assets/icons/logo.svg'; 
---

<button
  id="chat-toggle-btn"
  class="fixed bottom-6 right-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-emerald-600 text-white shadow-xl transition-transform hover:scale-105 hover:bg-emerald-700 focus:outline-none"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
  </svg>
</button>

<div
  id="chat-window"
  class="fixed bottom-24 right-6 z-50 hidden w-80 transform flex-col overflow-hidden rounded-2xl bg-white shadow-2xl transition-all duration-300 ease-in-out sm:w-96"
>
  <div class="flex items-center justify-between bg-emerald-500 p-4 text-white">
    <div class="flex items-center gap-3">
      <div class="flex h-10 w-10 items-center justify-center rounded-full bg-yellow-400">
        <Image 
          src={logoIcon} 
          alt="Logo Al Hijrah" 
          class="w-12 h-12 rounded-full" 
        />
      </div>
      <div>
        <h3 class="font-bold text-lg">Al-Hijrah Assistant</h3>
        <p class="text-xs text-emerald-100">Online</p>
      </div>
    </div>
    <button id="close-chat-btn" class="text-white hover:text-gray-200">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div id="chat-messages" class="flex h-80 flex-col space-y-4 overflow-y-auto bg-gray-50 p-4 scrollbar-thin scrollbar-thumb-emerald-200">
    <div class="flex justify-start">
        <div class="max-w-[85%] rounded-2xl rounded-tl-none bg-emerald-100 px-4 py-2 text-sm text-gray-800 shadow-sm">
            Hai, silakan bertanya. Pertanyaan anda akan dijawab otomatis oleh chatbot AI.
        </div>
    </div>
  </div>

  <div class="border-t border-gray-100 bg-white p-3">
    <div class="flex items-center gap-2 rounded-full border border-gray-200 bg-gray-50 px-2 py-1 focus-within:ring-2 focus-within:ring-emerald-500">
      <input
        type="text"
        id="user-input"
        class="w-full flex-1 bg-transparent px-3 py-2 text-sm outline-none placeholder:text-gray-400"
        placeholder="Ketik Pertanyaan..."
      />
      <button
        id="send-btn"
        class="flex h-9 w-9 items-center justify-center rounded-full bg-green text-white transition hover:bg-emerald-600 disabled:opacity-50"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  const toggleBtn = document.getElementById('chat-toggle-btn');
  const closeBtn = document.getElementById('close-chat-btn');
  const chatWindow = document.getElementById('chat-window');
  const sendBtn = document.getElementById('send-btn');
  const userInput = document.getElementById('user-input') as HTMLInputElement; // Type casting for TS
  const messagesContainer = document.getElementById('chat-messages');

  // toggle buka tutup chat
  function toggleChat() {
    chatWindow.classList.toggle('hidden');
    // Animasi sederhana
    if (!chatWindow.classList.contains('hidden')) {
        userInput.focus();
    }
  }

  toggleBtn.addEventListener('click', toggleChat);
  closeBtn.addEventListener('click', toggleChat);

  // add pesan
  function addMessage(text, sender) {
    const div = document.createElement('div');
    const isUser = sender === 'user';
    
    div.className = `flex ${isUser ? 'justify-end' : 'justify-start'}`;
    
    div.innerHTML = `
      <div class="max-w-[85%] px-4 py-2 text-sm shadow-sm ${
        isUser 
          ? 'bg-emerald-500 text-white rounded-2xl rounded-tr-none' 
          : 'bg-white border border-gray-200 text-gray-800 rounded-2xl rounded-tl-none'
      }">
        ${text}
      </div>
    `;
    
    messagesContainer.appendChild(div);
    messagesContainer.scrollTop = messagesContainer.scrollHeight; // Auto scroll 
  }

  // send to API
  async function handleSend() {
    const text = userInput.value.trim();
    if (!text) return;

    // Tampilkan pesan user
    addMessage(text, 'user');
    userInput.value = '';
    userInput.disabled = true; 

    try {
        
        const response = await fetch('http://127.0.0.1:8000/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question: text })
        });

        const data = await response.json();
        addMessage(data.response, 'bot');
        
    } catch (error) {
        console.error(error);
        addMessage("Maaf, server sedang sibuk. Coba lagi nanti.", 'bot');
    } finally {
        userInput.disabled = false;
        userInput.focus();
    }
  }

  // Event Listeners untuk Kirim
  sendBtn.addEventListener('click', handleSend);
  userInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') handleSend();
  });
</script>