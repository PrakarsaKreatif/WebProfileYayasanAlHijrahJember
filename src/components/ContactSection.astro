---
import lokasi from '../../src/assets/icons/lokasi.svg';
import whatsapp from '../../src/assets/icons/whatsapp.svg';

const icLocation = lokasi.src;
const icWa = whatsapp.src;
---

<section class="py-16 px-4 bg-white">
  <div class="max-w-[1000px] mx-auto">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold text-green">Lokasi & Kontak Kami</h2>
      <p class="text-gray-600">Berikut lokasi dan kontak yang dapat anda hubungi</p>
    </div>

    <div class="bg-[#E6F7F1] rounded-[2rem] p-6 shadow-md border border-emerald-100">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
        <div class="h-64 bg-gray-300 rounded-2xl overflow-hidden relative">
          <iframe width="100%" height="100%" style="border:0" loading="lazy" allowfullscreen src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3949.315030633633!2d113.71043287575527!3d-8.17098298189237!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dd695000a39bd87%3A0x5151077568c48ae0!2sKB%20TK%20Al-Hijrah!5e0!3m2!1sid!2sid!4v1766215004775!5m2!1sid!2sid"></iframe>
          <div class="absolute bottom-4 left-4 bg-white p-2 rounded-lg shadow text-xs font-bold text-red-500 flex items-center gap-1">
            📍 KB TK Al Hijrah
          </div>
        </div>

        <div class="space-y-4">
          <div class="bg-white p-4 rounded-xl shadow-sm flex items-start gap-3">
             <img src={icLocation} alt="Usia Anak" class="w-10" />
             <div>
               <p class="font-bold text-gray-800">Jl. Jawa II No.22</p>
               <p class="text-sm text-gray-500 mb-2">Jl. Jawa II No.22, Tegal Boto Lor, Sumbersari, Kec. Sumbersari, Kabupaten Jember, Jawa Timur</p>
               <a href="https://maps.app.goo.gl/XFqP47qzyiGdANZC9" class="mt-10 bg-green text-white text-xs px-4 py-2 rounded-full hover:bg-emerald-600">Lihat di Google Maps</a>
             </div>
          </div>

          <a href="https://wa.me/62895806789928" class="flex items-center gap-3 bg-[#25D366] text-white p-4 rounded-xl shadow-md hover:bg-[#20bd5a] transition">
            <img src={icWa} alt="Whatsapp Al Hijrah" class="w-10" />
            <div>
              <p class="text-xs opacity-90">WhatsApp</p>
              <p class="font-bold text-lg">Bu Inge</p>
            </div>
          </a>

          <a href="https://wa.me/62895806789927" class="flex items-center gap-3 bg-[#25D366] text-white p-4 rounded-xl shadow-md hover:bg-[#20bd5a] transition">
            <img src={icWa} alt="Whatsapp Al Hijrah" class="w-10" />
            <div>
              <p class="text-xs opacity-90">WhatsApp</p>
              <p class="font-bold text-lg">Mom Uci</p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>