---
import user from '../../src/assets/icons/icon_user.svg';
import card from '../../src/assets/icons/icon_card.svg';
import mandiri from '../../src/assets/icons/logo_bank_mandiri.svg'
import bri from '../../src/assets/icons/logo_bank_bri.svg'
import date from '../../src/assets/icons/calendar.svg'
import form from '../../src/assets/icons/document.svg'

const i_user = user.src;
const i_card = card.src
const i_mandiri = mandiri.src
const i_bri = bri.src
const i_date = date.src
const i_form = form.src
---

<div class="max-w-4xl mx-auto bg-white p-6 md:p-10 rounded-3xl shadow-xl border border-emerald-100">
  
  <h2 class="text-2xl md:text-3xl font-bold text-green mb-7 text-center">Formulir Pendaftaran</h2>
  <!-- <p class="text-center text-gray-500 mb-8"></p> -->

  <div class="mb-8">
    <div class="flex justify-between items-center text-xs font-semibold text-gray-500  mb-2 px-2">
      <span class="step-label">Identitas Anak</span>
      <span class="step-label">Data Orang Tua</span>
      <span class="step-label">Kondisi Anak</span>
      <span class="step-label">Pilihan SPP</span>
    </div>
    <div class="w-full bg-gray-200 rounded-full h-2.5">
      <div id="progress-bar" class="bg-emerald-500 h-2.5 rounded-full transition-all duration-300" style="width: 25%"></div>
    </div>
  </div>
  
  <form 
    id="multi-step-form"
    method="POST"
    action="https://script.google.com/macros/s/AKfycby2NmngHfCFEUSnQJwuqvOyhwPhXv8zKM3QoZIX3kM6CFrp7iCJqrpQOzY7nwZhKSe1/exec" 

    
    class="space-y-6"
  >

    <div class="form-step">
      <h3 class="text-xl font-bold text-green border-b pb-2 mb-4">A. Identitas Anak Didik</h3>
      
      <div class="mb-6 bg-emerald-50 p-4 rounded-xl border border-emerald-200">
        <label class="block text-gray-800 font-bold mb-2">Pilih Kelompok Pendaftaran</label>
        <select id="kelompok-select" name="kelompok" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-emerald-500 bg-white">
          <option value="" disabled selected>-- Pilih Kelompok --</option>
          <option value="KB">KB (Kelompok Bermain)</option>
          <option value="TK">TK (Taman Kanak-Kanak)</option>
        </select>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div>
          <label class="label">Nama Lengkap</label>
          <input type="text" name="nama_lengkap" required class="input-field" />
        </div>
        <div>
          <label class="label">Nama Panggilan</label>
          <input type="text" name="nama_panggilan" required class="input-field" />
        </div>
      </div>

      <div class="mb-4">
        <label class="label">Jenis Kelamin</label>
        <div class="flex gap-4 mt-2">
          <label class="flex items-center cursor-pointer">
            <input type="radio" name="jenis_kelamin" value="Laki-laki" required class="mr-2 text-emerald-500 focus:ring-emerald-500"> Laki-laki
          </label>
          <label class="flex items-center cursor-pointer">
            <input type="radio" name="jenis_kelamin" value="Perempuan" required class="mr-2 text-emerald-500 focus:ring-emerald-500"> Perempuan
          </label>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 ">
        <div>
          <label class="label">Tempat Lahir</label>
          <input type="text" name="tempat_lahir" required class="input-field" />
        </div>
        <div>
          <label class="label">Tanggal Lahir</label>
          <input type="date" name="tanggal_lahir" required class="input-field" />
        </div>
      </div>

      <div class="mt-4 space-y-3">
        <label class="label">Alamat Rumah Lengkap</label>
        <input type="text" name="alamat_jalan" placeholder="Jalan / Dusun / RT RW" required class="input-field" />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <input type="text" name="alamat_desa" placeholder="Desa/Kelurahan" required class="input-field mt-2" />
          <input type="text" name="alamat_kecamatan" placeholder="Kecamatan" required class="input-field mt-2" />
          <input type="text" name="alamat_kabupaten" placeholder="Kabupaten" required class="input-field mt-2" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
        <div>
          <label class="label">Agama</label>
          <select name="agama" class="input-field bg-white">
            <option value="Islam">Islam</option>
            <option value="Kristen">Kristen</option>
            <option value="Katolik">Katolik</option>
            <option value="Hindu">Hindu</option>
            <option value="Buddha">Buddha</option>
          </select>
        </div>
        <div>
          <label class="label">Kewarganegaraan</label>
          <input type="text" name="kewarganegaraan" value="Indonesia" class="input-field" />
        </div>
        <div>
          <label class="label">NIK Anak</label>
          <input type="number" name="nik" required class="input-field" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
        <div>
          <label class="label">Cita-cita</label>
          <input type="text" name="cita_cita" class="input-field" />
        </div>
        <div>
          <label class="label">Hobi</label>
          <input type="text" name="hobi" class="input-field" />
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4">
        <div>
          <label class="label">Anak ke-</label>
          <input type="number" name="anak_ke" required class="input-field" />
        </div>
        <div>
          <label class="label">Jumlah Saudara Kandung</label>
          <input type="text" name="jml_sdr_kandung" placeholder="Isi - jika tdk ada" class="input-field" />
        </div>
        <div>
          <label class="label">Jumlah Saudara Tiri</label>
          <input type="text" name="jml_sdr_tiri" placeholder="Isi - jika tdk ada" class="input-field" />
        </div>
        <div>
           <label class="label">Status Anak</label>
           <select name="status_anak" class="input-field bg-white">
             <option value="Lengkap">Ortu Lengkap</option>
             <option value="Yatim">Yatim</option>
             <option value="Piatu">Piatu</option>
             <option value="Yatim Piatu">Yatim Piatu</option>
           </select>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
        <div>
          <label class="label">Bahasa Sehari-hari</label>
          <input type="text" name="bahasa_sehari" class="input-field" />
        </div>
        <div>
          <label class="label">Golongan Darah</label>
          <select name="gol_darah" class="input-field bg-white">
            <option value="-">Tidak Tahu</option>
            <option value="A">A</option>
            <option value="B">B</option>
            <option value="AB">AB</option>
            <option value="O">O</option>
          </select>
        </div>
      </div>

      <div class="mt-4">
        <label class="label">Penyakit Berat yg Pernah Diderita</label>
        <input type="text" name="penyakit_berat" placeholder="Isi - jika tidak ada" class="input-field" />
      </div>
       <div class="mt-4">
        <label class="label">Imunisasi yg Pernah Diterima</label>
        <input type="text" name="imunisasi" placeholder="Isi - jika tidak ada" class="input-field" />
      </div>
    </div>

    <div class="form-step hidden">
      <h3 class="text-xl font-bold text-green border-b pb-2 mb-4">B. Identitas Orangtua/Wali</h3>
      
      <div class="bg-gray-50 p-4 rounded-xl mb-6">
        <h4 class="font-bold text-emerald-600 mb-3">1. Data Ayah</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div><label class="label">Nama Ayah</label><input type="text" name="ayah_nama" required class="input-field" /></div>
            <div><label class="label">Tempat, Tgl Lahir</label><input type="text" name="ayah_ttl" required class="input-field" /></div>
            <div><label class="label">No. HP (WA)</label><input type="number" name="ayah_hp" required class="input-field" /></div>
            <div><label class="label">Pekerjaan</label><input type="text" name="ayah_pekerjaan" required class="input-field" /></div>
            <div class="md:col-span-2"><label class="label">Alamat Pekerjaan</label><input type="text" name="ayah_alamat_kerja" class="input-field" /></div>
            <div><label class="label">Pendidikan Terakhir</label><input type="text" name="ayah_pendidikan" class="input-field" /></div>
            <div><label class="label">Penghasilan Bulanan</label><select name="ayah_penghasilan" class="input-field bg-white">
                <option value="< 1 Juta">&lt; 1 Juta</option>
                <option value="1 - 3 Juta">1 - 3 Juta</option>
                <option value="3 - 5 Juta">3 - 5 Juta</option>
                <option value="> 5 Juta">&gt; 5 Juta</option>
            </select></div>
        </div>
      </div>

      <div class="bg-gray-50 p-4 rounded-xl">
        <h4 class="font-bold text-emerald-600 mb-3">2. Data Ibu</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div><label class="label">Nama Ibu</label><input type="text" name="ibu_nama" required class="input-field" /></div>
            <div><label class="label">Tempat, Tgl Lahir</label><input type="text" name="ibu_ttl" required class="input-field" /></div>
            <div><label class="label">No. HP (WA)</label><input type="number" name="ibu_hp" required class="input-field" /></div>
            <div><label class="label">Pekerjaan</label><input type="text" name="ibu_pekerjaan" required class="input-field" /></div>
            <div class="md:col-span-2"><label class="label">Alamat Pekerjaan</label><input type="text" name="ibu_alamat_kerja" class="input-field" /></div>
            <div><label class="label">Pendidikan Terakhir</label><input type="text" name="ibu_pendidikan" class="input-field" /></div>
            <div><label class="label">Penghasilan Bulanan</label><select name="ibu_penghasilan" class="input-field bg-white">
                <option value="< 1 Juta">&lt; 1 Juta</option>
                <option value="1 - 3 Juta">1 - 3 Juta</option>
                <option value="3 - 5 Juta">3 - 5 Juta</option>
                <option value="> 5 Juta">&gt; 5 Juta</option>
            </select></div>
        </div>
      </div>
    </div>

    <div class="form-step hidden">
      <h3 class="text-xl font-bold text-green border-b pb-2 mb-4">C. Kondisi Anak Didik</h3>
      <div class="space-y-4">
        <div>
            <label class="label">1. Kebiasaan Baik Anak</label>
            <textarea name="kebiasaan_baik" rows="2" class="input-field"></textarea>
        </div>
        <div>
            <label class="label">2. Kebiasaan Buruk Anak</label>
            <textarea name="kebiasaan_buruk" rows="2" class="input-field"></textarea>
        </div>
        <div>
            <label class="label">3. Bakat yang Dimiliki</label>
            <textarea name="bakat_anak" rows="2" class="input-field"></textarea>
        </div>
        <div>
            <label class="label">4. Larangan Makanan & Minuman</label>
            <textarea name="larangan_makan" rows="2" class="input-field"></textarea>
        </div>
        <div>
            <label class="label">5. Penyakit yang Pernah Diderita Anak (selain batuk, pilek, panas)</label>
            <textarea name="penyakit_lain" rows="2" class="input-field"></textarea>
        </div>
      </div>
    </div>

    <div class="form-step hidden">
      <h3 class="text-xl font-bold text-green border-b pb-2 mb-4">D. Pilihan SPP Perbulan</h3>
      
      <div id="spp-tk" class="hidden">
        <p class="mb-4 text-emerald-600 font-semibold">Pilihan SPP untuk kelompok <span class="font-bold underline">TK</span>:</p>
        <div class="space-y-3">
            <label class="flex items-center p-4 border rounded-xl cursor-pointer hover:bg-emerald-50 transition">
                <input type="radio" name="pilihan_spp" value="TK - 175.000" class="mr-3 text-emerald-500 focus:ring-emerald-500 w-5 h-5">
                <span class="font-bold">Rp 175.000</span>
            </label>
            <label class="flex items-center p-4 border rounded-xl cursor-pointer hover:bg-emerald-50 transition">
                <input type="radio" name="pilihan_spp" value="TK - 200.000" class="mr-3 text-emerald-500 focus:ring-emerald-500 w-5 h-5">
                <span class="font-bold">Rp 200.000</span>
            </label>
            <label class="flex items-center p-4 border rounded-xl cursor-pointer hover:bg-emerald-50 transition">
                <input type="radio" name="pilihan_spp" value="TK - 250.000" class="mr-3 text-emerald-500 focus:ring-emerald-500 w-5 h-5">
                <span class="font-bold">Rp 250.000</span>
            </label>
        </div>
      </div>

      <div id="spp-kb" class="hidden">
        <p class="mb-4 text-emerald-600 font-semibold">Pilihan SPP untuk kelompok <span class="font-bold underline">KB</span>:</p>
        <div class="space-y-3">
            <label class="flex items-center p-4 border rounded-xl cursor-pointer hover:bg-emerald-50 transition">
                <input type="radio" name="pilihan_spp" value="KB - 100.000" class="mr-3 text-emerald-500 focus:ring-emerald-500 w-5 h-5">
                <span class="font-bold">Rp 100.000</span>
            </label>
            <label class="flex items-center p-4 border rounded-xl cursor-pointer hover:bg-emerald-50 transition">
                <input type="radio" name="pilihan_spp" value="KB - 150.000" class="mr-3 text-emerald-500 focus:ring-emerald-500 w-5 h-5">
                <span class="font-bold">Rp 150.000</span>
            </label>
        </div>
      </div>
      
      <p id="spp-warning" class="text-red-500 mt-4 hidden">Silakan pilih kelompok pendaftaran di halaman pertama terlebih dahulu.</p>

      <div class="mt-8">
  <h3 class="text-lg font-bold text-gray-800 mb-3">Biaya Pendaftaran</h3>
  
  <div class="bg-[#E6F7F1] p-6 rounded-3xl border border-emerald-100">
    
    <div class="mb-6">
      <h4 id="wave-title" class="text-emerald-600 font-bold text-lg mb-2">Biaya Pendaftaran Gelombang 1</h4>
      <div class="space-y-2 text-sm md:text-base font-medium text-gray-600">
        <div class="flex items-center gap-2">
          <img src={i_date} alt="tanggal pendaftaran">
          <span id="wave-date">Desember 2025 s/d Februari 2026</span>
        </div>
        <div class="flex items-center gap-2">
          <img src={i_form} alt="formulir pendaftaran">
          <span id="wave-fee" class="font-bold text-emerald-700">Biaya Formulir Pendaftaran Rp 50.000</span>
        </div>
      </div>
    </div>

    <div class="bg-emerald-500 rounded-2xl p-6 text-white mb-6">
      <p class="font-semibold mb-4 text-center md:text-left">Biaya pendaftaran dapat dibayarkan melalui :</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        
        <div class="bg-white text-gray-800 p-4 rounded-xl shadow-sm relative group">
          <div class="h-8 mb-3 flex items-center">
            <img src={i_mandiri} alt="pembayaran melalui bank mandiri">
          </div>
          <div class="space-y-1 text-sm">
            <div class="flex items-center gap-2">
              <img src={i_user} alt="nama rekening">
              <span class="font-bold">Inge Marinda Prihartini</span>
            </div>
            <div class="block items-center gap-2 justify-between">
               <div class="flex items-center gap-2">
                 <img src={i_card} alt="nomor rekening">
                 <span class="font-mono text-base font-bold tracking-wide">1430013310857</span>
               </div>
               <button type="button" onclick="copyText('1430013310857')" class=" mt-2 bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold py-1 px-3 rounded-full transition">
                 Copy
               </button>
            </div>
          </div>
        </div>

        <div class="bg-white text-gray-800 p-4 rounded-xl shadow-sm relative group">
          <div class="h-8 mb-3 flex items-center">
             <div class="flex items-center gap-1">
               <img src={i_bri} alt="pembayaran melalui bank bri">
             </div>
          </div>
          <div class="space-y-1 text-sm">
            <div class="flex items-center gap-2">
              <img src={i_user} alt="nama rekening">
              <span class="font-bold">Inge Marinda Prihartini</span>
            </div>
            <div class="block items-center gap-2 justify-between">
               <div class="flex items-center gap-2">
                 <img src={i_card} alt="nomor rekening">
                 <span class="font-mono text-base font-bold tracking-wide">087201039480535</span>
               </div>
               <button type="button" onclick="copyText('087201039480535')" class="mt-2 bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold py-1 px-3 rounded-full transition">
                 Copy
               </button>
            </div>
          </div>
        </div>

      </div>
    </div>

    <div>
      <h4 class="text-emerald-600 font-bold mb-2">Upload Bukti Pembayaran</h4>
      <input 
        type="file" 
        id="input-bukti" 
        name="bukti_pembayaran"
        accept="image/*,application/pdf"
        class="block w-full text-sm text-gray-500
          file:mr-4 file:py-2 file:px-4
          file:rounded-full file:border-0
          file:text-sm file:font-semibold
          file:bg-white file:text-emerald-700
          file:border-emerald-200 file:border
          hover:file:bg-emerald-50
          border border-gray-300 rounded-lg p-2 bg-white"
      />
      <p class="text-xs text-gray-500 mt-1 ml-1">*Format: JPG, PNG, atau PDF. Maks 5MB.</p>
    </div>

  </div>
</div>
<script is:inline>
  // FUNGSI COPY TEXT (Untuk No Rekening)
  function copyText(text) {
    navigator.clipboard.writeText(text).then(() => {
      alert("Nomor Rekening berhasil disalin!");
    }).catch(err => {
      console.error('Gagal menyalin: ', err);
    });
  }

  // FUNGSI CEK TANGGAL OTOMATIS
  function updateWaveInfo() {
    const today = new Date();
    // testing
    // const today = new Date('2026-03-15'); 

    const waveTitle = document.getElementById('wave-title');
    const waveDate = document.getElementById('wave-date');
    const waveFee = document.getElementById('wave-fee');

    // Gelombang 1
    const wave1Start = new Date('2025-12-01');
    const wave1End = new Date('2026-02-28');
    
    // Gelombang 2
    const wave2Start = new Date('2026-03-01');
    const wave2End = new Date('2026-06-30');

    if (today >= wave2Start) {
      // Masuk Gelombang 2 (
      waveTitle.innerText = "Biaya Pendaftaran Gelombang 2";
      waveTitle.className = "text-emerald-600 font-bold text-lg mb-2"; 
      waveDate.innerText = "Maret 2026 s/d Juni 2026";
      waveFee.innerText = "Biaya Formulir Pendaftaran Rp 100.000";
    } else {
      // Masih Gelombang 1 
      waveTitle.innerText = "Biaya Pendaftaran Gelombang 1";
      waveTitle.className = "text-emerald-600 font-bold text-lg mb-2";
      waveDate.innerText = "Desember 2025 s/d Februari 2026";
      waveFee.innerText = "Biaya Formulir Pendaftaran Rp 50.000";
    }
  }

 
  document.addEventListener('DOMContentLoaded', updateWaveInfo);
</script>
    </div>

    <div class="flex justify-between pt-6 border-t mt-6">
      <button type="button" id="prev-btn" class="hidden px-6 py-2 rounded-full border border-gray-300 text-gray-600 font-semibold hover:bg-gray-100 transition">
        &larr; Kembali
      </button>
      
      <button type="button" id="next-btn" class="ml-auto bg-green hover:bg-emerald-600 text-white font-bold px-8 py-3 rounded-full shadow-md transition">
        Selanjutnya &rarr;
      </button>
      
      <button type="submit" id="submit-btn" class="hidden ml-auto bg-green hover:bg-emerald-700 text-white font-bold px-8 py-3 rounded-full shadow-lg transition">
        Kirim Pendaftaran
      </button>
    </div>

    <p id="form-message" class="text-center text-sm font-bold mt-4 hidden"></p>

  </form>
</div>

<style>
    .label {
        @apply block text-sm font-semibold text-gray-700 mb-1;
    }
    .input-field {
        @apply w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition;
    }
</style>

<script>
  let currentStep = 0;
  const steps = document.querySelectorAll('.form-step');
  const progressBar = document.getElementById('progress-bar');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const submitBtn = document.getElementById('submit-btn');
  const stepLabels = document.querySelectorAll('.step-label');

  //  SPP
  const kelompokSelect = document.getElementById('kelompok-select');
  const sppTkDiv = document.getElementById('spp-tk');
  const sppKbDiv = document.getElementById('spp-kb');
  const sppWarning = document.getElementById('spp-warning');

  function showStep(n) {
    // Sembunyikan semua step
    steps.forEach((step, index) => {
        step.classList.add('hidden');
        if(stepLabels[index]) {
            stepLabels[index].classList.remove('text-emerald-600', 'font-bold');
            stepLabels[index].classList.add('text-gray-400');
        }
    });

    // Tampilkan step saat ini
    steps[n].classList.remove('hidden');
    if(stepLabels[n]) {
        stepLabels[n].classList.remove('text-gray-400');
        stepLabels[n].classList.add('text-emerald-600', 'font-bold');
    }

    // Update Progress Bar
    const progressPercent = ((n + 1) / steps.length) * 100;
    if (progressBar) progressBar.style.width = `${progressPercent}%`;

    // Tombol Navigasi
    if (prevBtn) prevBtn.style.display = n === 0 ? 'none' : 'inline-block';
    
    if (n === steps.length - 1) {
        if(nextBtn) nextBtn.classList.add('hidden');
        if(submitBtn) submitBtn.classList.remove('hidden');
        handleSppDisplay();
    } else {
        if(nextBtn) {
            nextBtn.classList.remove('hidden');
            nextBtn.innerHTML = 'Selanjutnya &rarr;';
        }
        if(submitBtn) submitBtn.classList.add('hidden');
    }
  }

  function handleSppDisplay() {
      const selectedKelompok = kelompokSelect.value;
      if (sppTkDiv && sppKbDiv && sppWarning) {
          sppTkDiv.classList.add('hidden');
          sppKbDiv.classList.add('hidden');
          sppWarning.classList.add('hidden');

          if (selectedKelompok === 'TK') {
              sppTkDiv.classList.remove('hidden');
          } else if (selectedKelompok === 'KB') {
              sppKbDiv.classList.remove('hidden');
          } else {
              sppWarning.classList.remove('hidden');
          }
      }
  }

  function validateForm() {
    const currentStepDiv = steps[currentStep];
    const inputs = currentStepDiv.querySelectorAll('input[required], select[required]');
    let valid = true;

    inputs.forEach((input) => {
        if (!input.value) {
            valid = false;
            input.classList.add('border-red-500');
            setTimeout(() => input.classList.remove('border-red-500'), 2000);
        }
    });
    return valid;
  }

  // Event Listeners Navigasi
  if (nextBtn) {
      nextBtn.addEventListener('click', () => {
          if (validateForm()) {
              currentStep++;
              showStep(currentStep);
              window.scrollTo(0, 0);
          } else {
              alert("Mohon lengkapi data sebelum lanjut.");
          }
      });
  }

  if (prevBtn) {
      prevBtn.addEventListener('click', () => {
          currentStep--;
          showStep(currentStep);
          window.scrollTo(0, 0);
      });
  }

  // Initial Show
  showStep(currentStep);


  const form = document.getElementById('multi-step-form');
  // Casting ke HTMLInputElement 
  const fileInput = document.getElementById('input-bukti'); 
  const messageEl = document.getElementById('form-message');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      // Validasi SPP
      const selectedSpp = document.querySelector('input[name="pilihan_spp"]:checked');
      if (!selectedSpp) {
          alert("Mohon pilih nominal SPP terlebih dahulu.");
          return;
      }
      
      // UI Loading
      if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = 'Sedang Mengirim...';
          submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
      }

      const scriptURL = form.action;
      const formData = new FormData(form);
    
      // pengiriman data tunggal
      const sendData = () => {
        fetch(scriptURL, { method: 'POST', body: formData })
        .then(response => {
            window.location.href = "/registration-success";
            form.reset();
        })
        .catch(error => {
            // Error Handling
            console.error('Error!', error.message);
            if(messageEl) {
                messageEl.classList.remove('hidden');
                messageEl.classList.add('text-red-500');
                messageEl.innerText = "Terjadi kesalahan koneksi: " + error.message;
            }
            if(submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Coba Lagi';
                submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
            }
        });
      };

      if (fileInput && fileInput.files.length > 0) {
        const file = fileInput.files[0];
        const reader = new FileReader();
        
        reader.onload = function(e) {
            const result = e.target.result;
            // Ambil base64 
            const content = result.split(',')[1]; 
            
            // Tambahkan data file ke FormData
            formData.append('file_content', content);
            formData.append('file_mime', file.type);
            formData.append('file_name', file.name);
            
            sendData();
        };
        
        reader.readAsDataURL(file);
      } else {
        sendData();
      }
      

    });
  }
</script>