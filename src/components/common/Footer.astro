    <div class="border-t-2 border-white/80 pt-6 text-center">
      <p class="text-sm md:text-base font-medium tracking-wide">
        &copy; 2025 Yayasan Al Hijrah. All Right Reserved
      </p>
    </div>
    
  </div>
</footer>