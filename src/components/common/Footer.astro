---
import { Image } from 'astro:assets';
import logoIcon from '../../assets/icons/logo.svg'; 
---

<footer class="bg-green text-white font-poppins mt-auto">
  <div class="max-w-7xl mx-auto px-6 pt-8 pb-6">
    
    <div class="flex flex-col md:flex-row justify-between items-center gap-8 mb-8">
      
      <div class="flex items-center gap-4">
        <div class="w-20 h-20  rounded-full flex items-center justify-center border-black/10 overflow-hidden shadow-sm">
          <Image 
            src={logoIcon} 
            alt="Logo Yayasan Al Hijrah" 
            class="w-full h-full object-cover p-1" 
          />
        </div>
        
        <div class="flex flex-col">
          <span class="text-xl font-medium leading-tight">Yayasan</span>
          <span class="text-2xl md:text-3xl font-bold leading-tight tracking-wide">AL-Hijrah Jember</span>
        </div>
      </div>

      <div class="flex flex-col gap-4 self-center md:self-center items-start md:items-start">
        
        <a href="https://instagram.com/kb.tk.alhijrahjember" target="_blank" class="flex items-center gap-3 hover:text-yellow transition-colors group">
          <div class="bg-white text-green w-10 h-10 rounded-full flex items-center justify-center group-hover:bg-yellow group-hover:text-white transition-colors shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
