---
import multiIntel from '../../src/assets/icons/multiple_intelegensi.svg';
import penAqidah from '../../src/assets/icons/penanaman_aqidah.svg';
import kegEkstra from '../../src/assets/icons/kegiatan_ekstrakurikuler.svg';

const icMulti = multiIntel.src;
const icAqidah = penAqidah.src;
const icEkstra = kegEkstra.src;
---

<section class="py-10 px-4 bg-white">
  <div class="max-w-[1000px] mx-auto text-center">
    <div class="mb-10">
      <h2 class="text-3xl font-bold text-green mb-2">Konsep Pembelajaran</h2>
      <p class="text-gray-600">Berikut 3 konsep pembelajaran unggulan kami</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-red rounded-[2rem] p-6 text-white flex flex-col items-center shadow-lg hover:-translate-y-1 transition">
        <img src={icMulti} alt="Multiple Intelegensi Al Hijrah" class="w-20 mb-2" />
        <h3 class="font-bold mb-4">Pembelajaran<br/>Multiple Intelegensi</h3>
        <a href="/tkkb#konsepPembelajaran" class="bg-white text-red text-xs font-bold py-2 px-6 rounded-full mt-auto">Selengkapnya</a>
      </div>

      <div class="bg-yellow rounded-[2rem] p-6 text-white flex flex-col items-center shadow-lg hover:-translate-y-1 transition">
        <img src={icAqidah} alt="Penanaman Aqidah Al Hijrah" class="w-20 mb-2" />
        <h3 class="font-bold mb-4">Penanaman<br/>Aqidah</h3>
        <a href="/tkkb#konsepPembelajaran" class="bg-white text-yellow text-xs font-bold py-2 px-6 rounded-full mt-auto">Selengkapnya</a>
      </div>

      <div class="bg-blue rounded-[2rem] p-6 text-white flex flex-col items-center shadow-lg hover:-translate-y-1 transition">
        <img src={icEkstra} alt="Ekstrakurikuler Al Hijrah" class="w-20 mb-2" />
        <h3 class="font-bold mb-4">Kegiatan<br/>Ekstrakurikuler</h3>
        <a href="/tkkb#konsepPembelajaran" class="bg-white text-[#0EA5E9] text-xs font-bold py-2 px-6 rounded-full mt-auto">Selengkapnya</a>
      </div>
    </div>
  </div>
</section>