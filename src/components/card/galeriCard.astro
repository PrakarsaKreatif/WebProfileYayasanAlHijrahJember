---
    const {image, text} = Astro.props
---

<div class="h-auto bg-white rounded-xl overflow-hidden flex-wrap">
    <img src={image.src} class="w-full h-40 sm:h-48 lg:h-80 object-cover">
    <div class="flex items-center justify-center h-24 sm:h-24 lg:h-32">
        <h1 class="font-semibold text-xl sm:text-xl lg:text-2xl text-center text-green w-3/4 sm:w-2/3 lg:w-1/2 mx-auto">{text}</h1>
    </div>
</div>