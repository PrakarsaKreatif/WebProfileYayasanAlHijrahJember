---
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import '../styles/global.css';

const { title = "Yayasan Al-Hijrah", fullWidth = false } = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
   <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width" />
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <meta name="generator" content={Astro.generator} />
      
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
      
      <title>{title} | Yayasan Al-Hijrah Jember</title>
   </head>
   
   <body class="flex flex-col min-h-screen bg-[#E0F4EB] text-gray-900 font-poppins">
      
      <div class="w-full bg-white shadow-sm sticky top-0 z-50">
         <container>
            <Navbar />
         </container>
      </div>

      <main class="flex-grow w-full">
         <slot />
      </main>

       <div class="w-full bg-white border-t mt-auto">
           <container>
               <Footer />
           </container>
       </div>
        
   </body>
</html>