---
    import Layout from '../layouts/MainLayout.astro';
    import Card from '../components/card/galeriCard.astro'
    import tahfidzImg from '../assets/images/ekskul_tahfidz.jpeg'
    import englishImg from '../assets/images/english_club.jpeg'
    import drumbandImg from '../assets/images/drumband_putra.jpeg'
    import gymnasticImg from '../assets/images/ekskul_gymnastic.jpeg'
    import mewarnaiImg from '../assets/images/ekskul_mewarnai.jpeg'
    import tariImg from '../assets/images/ekskul_tari.jpeg'
    import hutImg from '../assets/images/hut_ri.jpg'
    import iduladhaImg from '../assets/images/idul_adha.jpeg'
    import kirabImg from '../assets/images/kirab.jpeg'
    import manasikImg from '../assets/images/manasik.jpeg'
    import sholatImg from '../assets/images/sholat.jpeg'
    import parentingImg from '../assets/images/parenting.jpeg'
    import upacaraImg from '../assets/images/upacara.jpeg'
    import senamImg from '../assets/images/senam.jpeg'

    import PageBanner from '../components/common/PageBanner.astro';

    const imageFiles = import.meta.glob('/src/assets/images/*.{jpeg,jpg,png,webp}', { eager: true });
    const bannerImages = Object.values(imageFiles).map((img: any) => img.default.src);

    const pageTitle = "Galeri TK & KB Al Hijrah";
    const pageSubtitle = "Berikut Galeri Kegiatan TK & KB Al Hijrah";
---

<Layout title={pageTitle}>
    <section class="max-w-4xl mx-auto pt-12 pb-12 text-center px-4 md:px-6">
        <PageBanner 
            title="Galeri Kegiatan Kami" 
            images={bannerImages}
        />

        <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-green mb-2 px-4">
            {pageTitle}
        </h1>
        <p class="text-gray-500 text-sm md:text-base max-w-2xl mx-auto px-4">
            {pageSubtitle}
        </p>
    </section>

    <section class="bg-[#10B981]/10 pt-8 pb-16 px-4 ">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-12 lg:gap-16 max-w-4xl mx-auto">
            <Card image={tahfidzImg} text="Ekstrakurikuler Tahfidz"/>
            <Card image={englishImg} text="Ekstrakurikuler English Club"/>
            <Card image={drumbandImg} text="Ekstrakurikuler Drumband"/>
            <Card image={mewarnaiImg} text="Ekstrakurikuler Mewarnai"/>
            <Card image={tariImg} text="Ekstrakurikuler Tari"/>
            <Card image={gymnasticImg} text="Ekstrakurikuler Gymnastic"/>
            <Card image={kirabImg} text="Kirab Budaya"/>
            <Card image={iduladhaImg} text="Latihan Berkurban"/>
            <Card image={parentingImg} text="Kegiatan Parenting"/>
            <Card image={manasikImg} text="Manasik Haji"/>
            <Card image={hutImg} text="Memperingati HUT RI ke 80"/>
            <Card image={upacaraImg} text="Kegiatan Upacara"/>
            <Card image={senamImg} text="Kegiatan Senam Pagi"/>
            <Card image={sholatImg} text="Kegiatan Sholat Berjamaah"/>
        </div>
    </section>
</Layout>