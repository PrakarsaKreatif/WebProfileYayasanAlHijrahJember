---
import Layout from '../layouts/MainLayout.astro';
import PageBanner from '../components/common/PageBanner.astro';

import {Image} from 'astro:assets';

// Import Data JSON
import tkkbData from '../data/tkkbData.json';

// Import Assets Icons (Visi & Misi)
import visiIcon from '../assets/icons/visi.svg';
import misiIcon from '../assets/icons/misi.svg';
import clockIcon from '../assets/icons/greenClock.svg'
import calendarIcon from '../assets/icons/calendar.svg'
import clock from '../assets/icons/clock.svg'

import multiIntel from '../../src/assets/icons/multiple_intelegensi.svg';
import penAqidah from '../../src/assets/icons/penanaman_aqidah.svg';
import kegEkstra from '../../src/assets/icons/kegiatan_ekstrakurikuler.svg';

const icMulti = multiIntel.src;
const icAqidah = penAqidah.src;
const icEkstra = kegEkstra.src;

const { 
  pageTitle, 
  pageSubtitle, 
  deskripsi, 
  visi, 
  misi, 
  "konsep pembelajaran": konsepPembelajaran, 
  "program penunjang": programPenunjang 
} = tkkbData;

const { pmi, pa, ke } = konsepPembelajaran;
const {inti, pilihan} = ke;

const imageFiles = import.meta.glob('/src/assets/images/*.{jpeg,jpg,png,webp}', { eager: true });
const bannerImages = Object.values(imageFiles).map((img: any) => img.default.src);
---

<Layout title={pageTitle}>
    
    <section class="max-w-4xl mx-auto pt-12 pb-1 text-center px-4 md:px-6">
        <div class="w-full aspect-video rounded-3xl mb-6 md:mb-8 overflow-hidden relative">
            <PageBanner 
                title="Galeri Kegiatan Kami" 
                images={bannerImages}
            />
        </div>

        <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-green px-4">
            {pageTitle}
        </h1>
        <p class="text-gray-500 text-sm md:text-base max-w-2xl mx-auto px-4">
            {pageSubtitle}
        </p>
    </section>


    <section class="bg-green/15 px-4 py-20 md:px-8 lg:px-20 rounded-xl my-8">
        <div class="max-w-4xl mx-auto">
            <div class="bg-white border-2 border-green/30 rounded-xl md:rounded-2xl p-6 md:p-8 lg:p-12 shadow-sm text-center">
                <h2 class="text-xl md:text-2xl font-bold text-green mb-4 md:mb-6">
                    Deskripsi TPA Al Hijrah
                </h2>
                <p class="text-gray-600 leading-relaxed text-sm md:text-base text-justify md:text-center">
                    {deskripsi}
                </p>
            </div>
        </div>
    </section>

    <section class="max-w-4xl mx-auto py-8 md:py-12 px-4 md:px-6">
        <div class="text-center mb-8 md:mb-10">
            <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-green mb-2">Visi & Misi Kami</h2>
            <p class="text-sm md:text-base text-gray-600 px-4">Berikut Visi & Misi TK & KB Al Hijrah</p>
        </div>

        <div class="flex flex-col gap-6 md:gap-8">
            
            <div class="rounded-2xl md:rounded-3xl overflow-hidden shadow-lg bg-green text-white">
                <div class="p-3 md:p-4 flex items-center justify-center gap-2 md:gap-3 border-b border-white">
                     <Image src={visiIcon} alt="Icon Visi" class="w-6 h-6 md:w-8 md:h-8" />
                     <h3 class="text-xl md:text-2xl tracking-wide">Visi</h3>
                </div>
                <div class="p-6 md:p-8 text-center flex items-center justify-center min-h-[80px] md:min-h-[100px]">
                    <p class="text-base md:text-lg lg:text-xl font-regular leading-relaxed">
                        {visi}
                    </p>
                </div>
            </div>

            <div class="rounded-2xl md:rounded-3xl overflow-hidden shadow-lg bg-green text-white">
                <div class="p-3 md:p-4 flex items-center justify-center gap-2 md:gap-3 border-b border-white">
                     <Image src={misiIcon} alt="Icon Misi" class="w-6 h-6 md:w-8 md:h-8" />
                     <h3 class="text-xl md:text-2xl tracking-wide">Misi</h3>
                </div>
                <div class="p-6 md:p-8 text-left">
                    <ul class="space-y-2 md:space-y-3 text-base md:text-lg font-regular">
                        {misi.map((item) => (
                            <li class="flex items-start gap-2 md:gap-3">
                                <span class="mt-2 md:mt-2.5 w-1.5 h-1.5 bg-white rounded-full flex-shrink-0"></span>
                                <span>{item}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section class=" mx-auto py-12 md:py-20 px-4 md:px-6 bg-green/15">
        <div class="text-center mb-8 md:mb-10">
                <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-green mb-2">Konsep Pembelajaran</h2>
                <p class="text-sm md:text-base text-gray-600 px-4">Yayasan Al-Hijrah memiliki 3 Konsep<br/>Pembelajaran. Berikut penjelasan lebih detail</p>
                
        </div>

        <div class="mx-auto max-w-5xl grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
            <div class="bg-red rounded-2xl md:rounded-[2rem] p-5 md:p-6 text-white flex flex-col items-center shadow-lg hover:-translate-y-1 transition">
                <img src={icMulti} alt="Multiple Intelegensi Al Hijrah" class="w-16 md:w-20 mb-2" />
                <h3 class="text-base md:text-lg font-bold mb-3 md:mb-4 text-center">Pembelajaran<br/>Multiple Intelegensi</h3>
                <ul class="w-full text-left text-sm md:text-base space-y-1 opacity-90">
                {pmi.map((item) => (
                    <li class="flex gap-2"><span>•</span> {item}</li>
                ))}
                </ul>
            </div>

            <div class="bg-yellow rounded-2xl md:rounded-[2rem] p-5 md:p-6 text-white flex flex-col items-center shadow-lg hover:-translate-y-1 transition">
                <img src={icAqidah} alt="Penanaman Aqidah Al Hijrah" class="w-16 md:w-20 mb-2" />
                <h3 class="text-base md:text-lg font-bold mb-3 md:mb-4 text-center">Penanaman<br/>Aqidah</h3>
                <ul class="w-full text-left text-sm md:text-base space-y-1 opacity-90">
                {pa.map((item) => (
                    <li class="flex gap-2"><span>•</span> {item}</li>
                ))}
                </ul>
            </div>

            <div class="bg-blue rounded-2xl md:rounded-[2rem] p-5 md:p-6 text-white flex flex-col items-center shadow-lg hover:-translate-y-1 transition">
                <img src={icEkstra} alt="Ekstrakurikuler Al Hijrah" class="w-16 md:w-20 mb-2" />
                <h3 class="text-base md:text-lg font-bold mb-3 md:mb-4 text-center">Kegiatan<br/>Ekstrakurikuler</h3>
                <h3 class="text-sm md:text-base font-bold text-left w-full">Ekstrakurikuler Inti</h3>
                <ul class="w-full text-left text-sm md:text-base space-y-1 opacity-90">
                {inti.map((item) => (
                    <li class="flex gap-2"><span>•</span> {item}</li>
                ))}
                </ul>
                <h3 class="text-sm md:text-base font-bold mt-2 text-left w-full">Ekstrakurikuler Pilihan</h3>
                <ul class="w-full text-left text-sm md:text-base space-y-1 opacity-90">
                {pilihan.map((item) => (
                    <li class="flex gap-2"><span>•</span> {item}</li>
                ))}
                </ul>
            </div>
        </div>
    </section>

    <section class="px-4 py-8 md:px-8 lg:px-20 rounded-xl my-8">
        <div class="max-w-4xl mx-auto">
            <div class="bg-white border-2 border-green/30 rounded-xl md:rounded-2xl p-6 md:p-8 lg:p-12 shadow-sm text-center">
                <h2 class="text-xl md:text-2xl font-bold text-green mb-4 md:mb-6">
                    Program Penunjang
                </h2>
                <ul class="w-full text-left text-base md:text-lg lg:text-xl space-y-1 opacity-90">
                {programPenunjang.map((item) => (
                    <li class="flex gap-2"><span>•</span> {item}</li>
                ))}
                </ul>
            </div>
        </div>

        <div class="max-w-6xl mx-auto mt-8 md:mt-10">
        <div class="bg-green border-2 border-green/30 rounded-xl md:rounded-2xl p-6 md:p-8 lg:p-12 shadow-sm">
            
            <!-- Header -->
            <div class="flex items-center justify-center gap-2 md:gap-3">
            <Image src={clock} alt="Icon Clock" class="w-10 h-10 md:w-12 md:h-12" />
            <h3 class="font-medium text-lg md:text-xl leading-tight text-white tracking-wide">
                Waktu <br /> Pembelajaran
            </h3>
            </div>

            <!-- Cards -->
            <div class="mt-6 md:mt-8 grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
            
            <!-- KB -->
            <div class="bg-white rounded-xl md:rounded-2xl p-5 md:p-6 text-green shadow-sm">
                <h4 class="font-bold text-base md:text-lg mb-3 md:mb-4">
                Kelompok Bermain (KB)
                </h4>

                <div class="flex items-center gap-2 md:gap-3 text-sm md:text-base text-gray-600">
                <Image src={calendarIcon} alt="Calendar" class="w-5 h-5 md:w-6 md:h-6" />
                <span>Hari Senin - Jum'at</span>
                </div>

                <div class="mt-2 md:mt-3 flex items-center gap-2 md:gap-3 text-sm md:text-base text-gray-600">
                <Image src={clockIcon} alt="Clock" class="w-5 h-5 md:w-6 md:h-6" />
                <span>Pukul 08.00 - 10.00</span>
                </div>
            </div>

            <!-- TK A & TK B -->
            <div class="bg-white rounded-xl md:rounded-2xl p-5 md:p-6 text-green shadow-sm">
                <h4 class="font-bold text-base md:text-lg mb-4 md:mb-5">
                Kelompok TK A & TK B
                </h4>

                <div class="flex flex-col md:flex-row items-start gap-4 md:gap-6">
                
                <!-- Senin - Kamis -->
                <div class="flex-1 w-full">
                    <div class="flex items-center gap-2 md:gap-3 text-sm md:text-base text-gray-600">
                    <Image src={calendarIcon} alt="Calendar" class="w-5 h-5 md:w-6 md:h-6" />
                    <span>Hari Senin - Kamis</span>
                    </div>

                    <div class="mt-2 md:mt-3 flex items-center gap-2 md:gap-3 text-sm md:text-base text-gray-600">
                    <Image src={clockIcon} alt="Clock" class="w-5 h-5 md:w-6 md:h-6" />
                    <span>Pukul 07.00 - 11.00</span>
                    </div>
                </div>

                <!-- Divider -->
                <span class="hidden md:inline-block w-[2px] h-14 bg-green"></span>
                <span class="md:hidden w-full h-[2px] bg-green"></span>

                <!-- Jumat -->
                <div class="flex-1 w-full">
                    <div class="flex items-center gap-2 md:gap-3 text-sm md:text-base text-gray-600">
                    <Image src={calendarIcon} alt="Calendar" class="w-5 h-5 md:w-6 md:h-6" />
                    <span>Hari Jum'at</span>
                    </div>

                    <div class="mt-2 md:mt-3 flex items-center gap-2 md:gap-3 text-sm md:text-base text-gray-600">
                    <Image src={clockIcon} alt="Clock" class="w-5 h-5 md:w-6 md:h-6" />
                    <span>Pukul 07.00 - 11.00</span>
                    </div>
                </div>

                </div>
            </div>

            </div>
        </div>
        </div>
    </section>
</Layout>