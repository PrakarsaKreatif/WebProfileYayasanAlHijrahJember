---
import Layout from '../layouts/MainLayout.astro';
import { Image } from 'astro:assets';

// Import Data JSON
import tpaData from '../data/tpaData.json';

// Import Assets Icons (Visi & Misi)
import visiIcon from '../assets/icons/visi.svg';
import misiIcon from '../assets/icons/misi.svg';

const { pageTitle, pageSubtitle, deskripsi, visi, misi } = tpaData;
---

<Layout title={pageTitle}>
    
    <section class="max-w-4xl mx-auto pt-2 pb-12 text-center">
        <div class="w-full aspect-video bg-gray-200 rounded-3xl mb-8 flex items-center justify-center border-2 border-dashed border-gray-300">
            <span class="text-gray-400 font-medium text-lg">
                PLACEHOLDER IMAGE
            </span>
        </div>

        <h1 class="text-3xl md:text-4xl font-bold text-green mb-2">
            {pageTitle}
        </h1>
        <p class="text-gray-500 text-sm md:text-base max-w-2xl mx-auto">
            {pageSubtitle}
        </p>
    </section>

    <section class="bg-green/15 -mx-4 px-4 py-16 md:-mx-8 md:px-8 lg:-mx-20 lg:px-20 rounded-xl my-8">
        <div class="max-w-4xl mx-auto">
            <div class="bg-white border-2 border-green/30 rounded-2xl p-8 md:p-12 shadow-sm text-center">
                <h2 class="text-2xl font-bold text-green mb-6">
                    Deskripsi TPA Al Hijrah
                </h2>
                <p class="text-gray-600 leading-relaxed text-sm md:text-base text-justify md:text-center">
                    {deskripsi}
                </p>
            </div>
        </div>
    </section>

    <section class="max-w-4xl mx-auto py-12">
        <div class="text-center mb-10">
            <h2 class="text-3xl font-bold text-green mb-2">Visi & Misi Kami</h2>
            <p class="text-gray-500 text-sm">Berikut Visi & Misi TPA (Taman Pengasuhan Anak) Al Hijrah</p>
        </div>

        <div class="flex flex-col gap-8">
            
            <div class="rounded-3xl overflow-hidden shadow-lg bg-green text-white">
                <div class="p-4 flex items-center justify-center gap-3 border-b border-white">
                     <Image src={visiIcon} alt="Icon Visi" class="w-8 h-8" />
                     <h3 class="text-2xl tracking-wide">Visi</h3>
                </div>
                <div class="p-8 text-center flex items-center justify-center min-h-[100px]">
                    <p class="text-lg md:text-xl font-regular leading-relaxed">
                        {visi}
                    </p>
                </div>
            </div>

            <div class="rounded-3xl overflow-hidden shadow-lg bg-green text-white">
                <div class="p-4 flex items-center justify-center gap-3 border-b border-white">
                     <Image src={misiIcon} alt="Icon Misi" class="w-8 h-8" />
                     <h3 class="text-2xl tracking-wide">Misi</h3>
                </div>
                <div class="p-8 text-left">
                    <ul class="space-y-3 text-lg font-regular">
                        {misi.map((item) => (
                            <li class="flex items-start gap-3">
                                <span class="mt-2.5 w-1.5 h-1.5 bg-white rounded-full flex-shrink-0"></span>
                                <span>{item}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>

        </div>
    </section>

</Layout>