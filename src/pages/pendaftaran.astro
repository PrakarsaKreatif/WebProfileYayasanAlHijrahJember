---
import Layout from '../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import hutRiImg from '../assets/images/hut_ri.jpg';
import RegistrationSection from '../components/RegistrationSection.astro';

// Import Data JSON
import tpaData from '../data/tpaData.json';

// Import Assets Icons (Visi & Misi)

const { pageTitle } = tpaData;
---

<Layout title={pageTitle}>
    
    <section class="max-w-4xl mx-auto pt-12 pb-12 text-center">
      <div class="w-full aspect-video rounded-3xl mb-8 overflow-hidden relative">
      <Image 
         src={hutRiImg} 
         alt="Perayaan HUT RI"
         class="w-full h-full object-cover" 
      />
      </div>

        <h1 class="text-3xl md:text-4xl font-bold text-green mb-2">
            {pageTitle}
        </h1>
        <p class="text-gray-500 text-sm md:text-base max-w-2xl mx-auto">
            Berikut informasi lebih detail terkait Pendaftaran TK & KB Al Hijrah
        </p>
    </section>

    <section class="pb-12">
      <RegistrationSection/>
    </section>
</Layout>