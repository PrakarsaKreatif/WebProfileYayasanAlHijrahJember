---
import Layout from "../layouts/MainLayout.astro";
import PageBanner from '../components/common/PageBanner.astro';
import { Image } from "astro:assets";

// Import Data JSON
import prestasiData from "../data/prestasiData.json";

// Import Assets 
import prestasiIcon from "../assets/icons/medali.svg";

const { pageTitle, pageSubtitle, prestasi } = prestasiData;
const imageFiles = import.meta.glob('/src/assets/images/*.{jpeg,jpg,png,webp}', { eager: true });
const bannerImages = Object.values(imageFiles).map((img: any) => img.default.src);
---

<Layout title={pageTitle}>
    <section class="max-w-4xl mx-auto pt-12 pb-12 text-center px-4 md:px-6">
        <PageBanner 
            title="Galeri Kegiatan Kami" 
            images={bannerImages}
        />

        <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-green mb-2 px-4">
            {pageTitle}
        </h1>
        <p class="text-gray-500 text-sm md:text-base max-w-2xl mx-auto px-4">
            {pageSubtitle}
        </p>
    </section>

    <section class="bg-[#10B981]/10 pt-8 pb-16 px-4">
        <div class="max-w-4xl mx-auto space-y-4">
            {
                prestasi.map((item) => (
                    <div class="flex items-center gap-4 p-3 md:p-4 bg-white border-[2px] border-[#2CB276]/100 rounded-[20px] md:rounded-[24px] shadow-sm transition-transform hover:scale-[1.01]">
                        <div class="flex-shrink-0">
                            <Image src={prestasiIcon} alt="Icon Medali" class="w-12 h-12 md:w-16 md:h-16 object-contain"/>
                        </div>

                        <p class="font-semibold text-[#333333] text-sm md:text-xl lg:text-[18px] leading-snug md:leading-[32px] text-left">
                            {item}
                        </p>
                    </div>
                ))
            }
        </div>
    </section>
</Layout>
