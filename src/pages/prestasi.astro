---
import Layout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";

// Import Data JSON
import prestasiData from "../data/prestasiData.json";

// Import Assets 
import prestasiIcon from "../assets/icons/medali.svg";
import pialaIcon from "../assets/images/Piala.png";

const { pageTitle, pageSubtitle, prestasi } = prestasiData;
---

<Layout title={pageTitle}>
   <section class="max-w-4xl mx-auto pt-8 md:pt-12 pb-12 px-4 text-center">
    <div class="w-full aspect-video bg-gray-200 rounded-[24px] md:rounded-[32px] mb-8 flex items-center justify-center overflow-hidden shadow-sm">
        <Image src={pialaIcon} alt="Foto Prestasi Utama" class="w-full h-full object-cover"/>
    </div>
    <h1 class="text-2xl md:text-[32px] font-bold text-[#10B981] mb-2 leading-tight md:leading-[40px]">
        {pageTitle}
    </h1>
    <p class="text-gray-500 text-sm md:text-base max-w-2xl mx-auto px-2">
        {pageSubtitle}
    </p>
</section>

<section class="bg-[#10B981]/10 pt-8 pb-16 px-4">
    <div class="max-w-4xl mx-auto space-y-4">
        {
            prestasi.map((item) => (
                <div class="flex items-center gap-4 p-3 md:p-4 bg-white border-[2px] border-[#2CB276]/100 rounded-[20px] md:rounded-[24px] shadow-sm transition-transform hover:scale-[1.01]">
                    <div class="flex-shrink-0">
                        <Image src={prestasiIcon} alt="Icon Medali" class="w-12 h-12 md:w-16 md:h-16 object-contain"/>
                    </div>

                    <p class="font-semibold text-[#333333] text-sm md:text-xl lg:text-[18px] leading-snug md:leading-[32px] text-left">
                        {item}
                    </p>
                </div>
            ))
        }
    </div>
</section>
</Layout>
