---
import MainLayout from '../layouts/MainLayout.astro';
import Container from '../components/common/Container.astro';
import RegistrationForm from '../components/RegistrationForm.astro';
---

<MainLayout title="Pendaftaran Siswa Baru">
  
  <section class="bg-[#F0FDF9] py-16">
    <Container>
      
      <div class="text-center mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-emerald-500 mb-4">
          Pendaftaran Siswa Baru
        </h1>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Silakan isi formulir di bawah ini dengan data yang benar
        </p>
      </div>

      <RegistrationForm />

    </Container>
  </section>

</MainLayout>